{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "ipc": false,
  "reload_style_on_change": true,
  "height": 45,

  "modules-left": [
    "dwl/tags",
    "wlr/taskbar",
    "dwl/window"
  ],

  "modules-center": [
    "mpris"
  ],

  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "clock",
    "custom/notification",
    "custom/power"
  ],

  // -----------------------
  // WORKSPACES / TAGS
  // -----------------------
  "dwl/tags": {
    "num-tags": 9,
    "hide-vacant": true
  },

  "dwl/window": {
    "format": "{}"
  },

  // -----------------------
  // MEDIA (MPRIS - Tauon friendly)
  // -----------------------
  "mpris": {
  "format": "♪ {title:.35}",
  "format-paused": "⏸ {title:.35}",
  "on-click": "playerctl play-pause",
  "on-click-right": "playerctl next",
  "on-click-middle": "playerctl previous"
},

  // -----------------------
  // NOTIFICATIONS
  // -----------------------
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },

  // -----------------------
  // UPDATES
  // -----------------------
  "custom/updates": {
    "format": "󰚰 {}",
    "interval": 300,
    "exec": "i=$(checkupdates 2>/dev/null); echo \"$i\" | wc -l",
    "on-click": "kitty -e yay -Syu"
  },

  // -----------------------
  // SYSTEM MODULES
  // -----------------------


  "pulseaudio": {
  "format": "{icon} {volume}%",
  "format-muted": " Muted",

  "format-icons": {
    "default": ["", "", ""]
  },

  "on-click": "pamixer -t",
  "on-scroll-up": "pamixer -i 2",
  "on-scroll-down": "pamixer -d 2"
},

  // -----------------------
  // NETWORK / TRAY
  // -----------------------
  "network": {
    "format-wifi": "{essid} {signalStrength}% ",
    "format-ethernet": "󰈀 NET",
    "format-disconnected": "Disconnected"
  },

  "tray": {
    "icon-size": 21,
    "spacing": 10
  },

  // -----------------------
  // CLOCK
  // -----------------------
  "clock": {
    "format": "{:%I:%M %p} ",
    "format-alt": "{:%A, %B %d, %Y}"
},

  // -----------------------
  // POWER BUTTON
  // -----------------------
  "custom/power": {
    "format": "",
    "on-click": "wlogout -b 6 --protocol layer-shell",
    "on-click-right": "bash ~/.config/eww/System-Menu/launch"
  }
}
